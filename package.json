{
  "name": "adi-rest-status",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "npm run build && vercel --prod",
    "add:animated-icons": "npx shadcn@latest add @animate-ui/icons-hugeicons-sun-medium @animate-ui/icons-hugeicons-moon-02",
    "add:animated-sun": "npx shadcn@latest add @animate-ui/icons-hugeicons-sun-medium",
    "add:animated-moon": "npx shadcn@latest add @animate-ui/icons-hugeicons-moon-02"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "m3-svelte": "^7.2.1",
    "svelte": "^5.40.0",
    "vite": "^7.3.6",
    "@ktibow/iconset-material-symbols": "^0.0.1764827375",
    "@sveltejs/adapter-vercel": "^5.8.0"
  },
  "devDependencies": {
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite-plugin-functions-mixins": "latest"
  }
}
