{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adi-rest-status-monitor",\n  "routes": [{ "pattern": "monitor.adi.rest", "custom_domain": true }],
  "main": "monitor-worker.js",
  "compatibility_date": "2026-10-21",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [\n    { "binding": "STATUS_HISTORY", "bucket_name": "adi-rest-status-history" }\n  ],\n  "vars": {
    "MONITOR_API_URL": "https://status.adi.rest"
  }
}
