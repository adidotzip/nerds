{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adi-rest-status",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  }
}
